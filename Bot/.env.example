# ============================================
# Telegram Bot Configuration
# ============================================
# Скопируйте этот файл в .env и заполните значениями

# --------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# --------------------------------------------

# Telegram Bot Token (получить у @BotFather)
# Пример: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TOKEN=your_telegram_bot_token_here

# Модель Ollama по умолчанию
# Пример: llama2:7b, nemotron-3-nano:latest
INITMODEL=llama2:7b

# --------------------------------------------
# ДОСТУП ПОЛЬЗОВАТЕЛЕЙ
# --------------------------------------------

# Ваш Telegram User ID (узнать у бота @userinfobot)
# Пример: 123456789
ADMIN_IDS=your_admin_id_here

# ID пользователей, которым разрешено использовать бота
# Перечислить через запятую без пробелов
# Пример: 123456789,987654321,111222333
USER_IDS=your_user_ids_here

# --------------------------------------------
# OLLAMA НАСТРОЙКИ
# --------------------------------------------

# Адрес сервера Ollama
# Если Ollama на том же компьютере: localhost
# Если на другом: IP-адрес или домен
OLLAMA_BASE_URL=localhost

# Порт Ollama (по умолчанию 11434)
OLLAMA_PORT=11434

# --------------------------------------------
# ОПЦИИ БОТА
# --------------------------------------------

# Разрешить всем участникам групп использовать бота
# 0 = только пользователи из USER_IDS
# 1 = все участники групп
ALLOW_ALL_USERS_IN_GROUPS=0

# Таймаут запросов к Ollama в миллисекундах
# Рекомендуется 3000-5000 (3-5 секунд)
TIMEOUT=3000

# --------------------------------------------
# ЛОГИРОВАНИЕ
# --------------------------------------------

# Уровень логирования
# Варианты: DEBUG, INFO, WARNING, ERROR, CRITICAL
# https://docs.python.org/3/library/logging.html#logging-levels
LOG_LEVEL=INFO

# --------------------------------------------
# MAX MESSENGER (опционально)
# --------------------------------------------
# Раскомментируйте и заполните для работы с MAX мессенджером

# MAX_TOKEN=your_max_bot_token
# MAX_API_BASE_URL=https://platform-api.max.ru
# MAX_LONGPOLL_TIMEOUT=30
# MAX_LONGPOLL_LIMIT=100
# MAX_UPDATE_TYPES=message_created,message_callback,bot_started

# --------------------------------------------
# ПРИМЕРЫ
# --------------------------------------------
# TOKEN=9876543210:ABCdef123456GHIjkl789012MNOpqr
# ADMIN_IDS=1416853313
# USER_IDS=1416853313,1234567890
# INITMODEL=nemotron-3-nano:latest
# OLLAMA_BASE_URL=192.168.0.100
# OLLAMA_PORT=11434
# ALLOW_ALL_USERS_IN_GROUPS=0
# TIMEOUT=3000
# LOG_LEVEL=DEBUG
